{
  "name": "vibe_backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:services": "bun test tests/services/*.test.ts",
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "wrangler:dev": "wrangler dev",
    "wrangler:tail": "wrangler tail",
    "cleanup:r2dev": "bun run scripts/cleanup-r2dev.ts",
    "init-tags": "bun run scripts/init-tags.ts",
    "init-tags:en": "bun run scripts/init-tags-en.ts",
    "test-tags": "bun run scripts/test-tags.ts",
    "fake:import": "bun run fake-data/import.ts",
    "fake:event": "bun run fake-data/import.ts --events-only",
    "fake:event:clear": "bun run fake-data/import.ts --events-only --events-clear",
    "test:seed": "bun run tests/seedFakeData.ts",
    "test:presign": "bun run scripts/test-presign.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.857.0",
    "@aws-sdk/s3-request-presigner": "^3.857.0",
    "@elysiajs/swagger": "^1.3.1",
    "@libsql/client": "^0.15.10",
    "@prisma/adapter-d1": "^6.16.2",
    "@prisma/adapter-libsql": "^6.13.0",
    "@prisma/client": "6.15.0",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "jose": "^5.9.6",
    "prismabox": "^1.1.24",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bun-types": "latest",
    "wrangler": "^4.28.1"
  },
  "module": "src/index.js"
}