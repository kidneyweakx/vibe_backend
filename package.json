{
  "name": "vibe_backend",
  "version": "1.0.50",
  "scripts": {
    "test": "./test/run.sh",
    "test:unit": "./test/run.sh test/unit",
    "test:e2e": "./test/run.sh test/e2e",
    "test:watch": "DATABASE_URL=file:./prisma/test.db API_ACCESS_TOKEN=test-token bun test --watch",
    "test:coverage": "./test/run.sh --coverage",
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "wrangler:dev": "wrangler dev",
    "wrangler:tail": "wrangler tail",
    "cleanup:r2dev": "bun run scripts/cleanup-r2dev.ts",
    "init-tags": "bun run scripts/init-tags.ts",
    "init-tags:en": "bun run scripts/init-tags-en.ts",
    "load-test": "bun run test/run-tests.ts load",
    "load-test:stress": "bun run test/run-tests.ts stress",
    "load-test:spike": "bun run test/run-tests.ts spike",
    "load-test:endurance": "bun run test/run-tests.ts endurance",
    "load-test:quick": "bun run test/quick-test.ts",
    "load-test:monitor": "bun run test/monitor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.857.0",
    "@aws-sdk/s3-request-presigner": "^3.857.0",
    "@elysiajs/swagger": "^1.3.1",
    "@libsql/client": "^0.15.10",
    "@prisma/adapter-d1": "^6.16.2",
    "@prisma/adapter-libsql": "^6.13.0",
    "@prisma/client": "6.15.0",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "jose": "^5.9.6",
    "prismabox": "^1.1.24",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "artillery": "^2.0.25",
    "bun-types": "latest",
    "wrangler": "^4.28.1"
  },
  "module": "src/index.js"
}