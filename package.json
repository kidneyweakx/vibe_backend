{
  "name": "vibe_backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:watch": "bun test --watch",
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "wrangler:dev": "wrangler dev",
    "wrangler:dev:test": "wrangler dev --env test",
    "wrangler:tail": "wrangler tail",
    "init:test-d1": "bun run scripts/init-test-d1.ts",
    "init:tags": "bun run scripts/init-tags.ts",
    "init:preset-tags": "bun run scripts/init-preset-tags.ts",
    "seed:journey:d1": "bun run scripts/seed-journey-data-d1.ts",
    "cleanup:r2dev": "bun run scripts/cleanup-r2dev.ts",
    "cleanup:orphaned": "bun run scripts/cleanup-orphaned-photos.ts --dry-run",
    "cleanup:orphaned:force": "bun run scripts/cleanup-orphaned-photos.ts",
    "diagnose:r2": "bun run scripts/diagnose-r2.ts",
    "db:export-clear": "bun run scripts/export-and-clear-d1.ts",
    "db:export-clear:prod": "bun run scripts/export-and-clear-d1.ts --env production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.857.0",
    "@aws-sdk/s3-request-presigner": "^3.857.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-d1": "^6.16.2",
    "@prisma/client": "6.15.0",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "jose": "^5.9.6",
    "nanoid": "^5.1.6",
    "prismabox": "^1.1.24",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "bun-types": "latest",
    "wrangler": "^4.28.1"
  },
  "module": "src/index.js"
}