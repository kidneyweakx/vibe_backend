{
  "name": "vibe_backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:services-coverage": "bun test 2>&1 | grep -E '^ src/services/'",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:watch": "bun test --watch",
    "dev": "bun run --watch src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "wrangler:dev": "wrangler dev",
    "wrangler:tail": "wrangler tail",
    "cleanup:r2dev": "bun run scripts/cleanup-r2dev.ts",
    "init-tags": "bun run scripts/init-tags.ts",
    "init-tags:en": "bun run scripts/init-tags-en.ts",
    "load-test": "bunx artillery run test/load-test-simple.yml -o test/load-test-report.json && node test/parse-load-report.js test/load-test-report.json",
    "load-test:prod": "bunx artillery run test/load-test-production.yml -o test/load-test-production-report.json && node test/parse-load-report.js test/load-test-production-report.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.857.0",
    "@aws-sdk/s3-request-presigner": "^3.857.0",
    "@elysiajs/swagger": "^1.3.1",
    "@libsql/client": "^0.15.10",
    "@prisma/adapter-d1": "^6.16.2",
    "@prisma/adapter-libsql": "^6.13.0",
    "@prisma/client": "6.15.0",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "jose": "^5.9.6",
    "prismabox": "^1.1.24",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "artillery": "^2.0.25",
    "bun-types": "latest",
    "wrangler": "^4.28.1"
  },
  "module": "src/index.js"
}