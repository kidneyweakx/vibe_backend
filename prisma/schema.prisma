generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatar       String?
  gender       String?  // "male" | "female" | "other"
  provider     String   // "google" | "apple" | "password" | "test"
  providerId   String   // OAuth provider user ID or email for password auth
  passwordHash String?  // For password authentication
  bio          String?
  location     String?
  language     String?
  timezone     String?
  notificationsEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photos       Photo[]
  givenRatings Rating[] @relation("RaterUser")
  receivedRatings Rating[] @relation("RatedUser")
  reportsSubmitted Report[] @relation("ReportReporter")
  onboarding   Onboarding?

  @@unique([provider, providerId])
  @@map("users")
}

model Photo {
  id         String   @id @default(cuid())
  userId     String
  key        String   @unique // R2 storage key
  url        String   // Public URL
  format     String   // image format (png, jpg, etc.)
  size       Int      // file size in bytes
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings    Rating[]
  photoTags  PhotoTag[]
  reports    Report[]

  @@map("photos")
}

model Rating {
  id        String   @id @default(cuid())
  raterId   String   // 評分者
  ratedUserId String // 被評分者
  photoId   String   // 被評分的照片
  type      String   // "like" (❤️) or "normal" (🔄)
  createdAt DateTime @default(now())
  
  rater     User     @relation("RaterUser", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser User     @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([raterId, photoId]) // 每個人對每張照片只能評分一次
  @@map("ratings")
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique // 標籤名稱 (英文)
  displayName String     // 顯示名稱 (中文)
  emoji       String?    // 可選的 emoji 圖示
  color       String?    // 標籤顏色 (hex code)
  category    String?    // 標籤分類 (如: style, occasion, season)
  createdAt   DateTime   @default(now())
  photoTags   PhotoTag[]

  @@map("tags")
}

model PhotoTag {
  id      String @id @default(cuid())
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([photoId, tagId]) // 每張照片對每個標籤只能關聯一次
  @@map("photo_tags")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  key         String   @unique // R2 storage key
  url         String   // Public URL
  imageUrl    String?  // Public image URL (may be same as url); presigned GET will be generated at runtime
  format      String   // image format (webp preferred)
  size        Int      // file size in bytes
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Report {
  id         String   @id @default(cuid())
  photoId    String
  reporterId String?
  reason     String
  createdAt  DateTime @default(now())

  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reporter User?  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([photoId])
  @@index([reporterId])
  @@map("reports")
}

model Onboarding {
  id                   String   @id @default(cuid())
  userId               String   @unique
  ageRange             String
  vibeLevel            Int
  timeInvestmentHours  Int
  notificationsEnabled Boolean
  tosVersion           String
  privacyVersion       String
  acceptedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding")
}