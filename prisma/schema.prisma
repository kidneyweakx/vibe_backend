generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  avatar       String?
  gender       String?  // "male" | "female" | "other"
  provider     String?  // "google" | "apple" | "guest" | null (deleted)
  providerId   String?  // OAuth provider user ID, null for guest or deleted
  passwordHash String?
  deviceId     String?  // Device identifier for guest users
  bio          String?
  location     String?
  language     String?
  timezone     String?
  isGuest      Boolean  @default(false)
  isDeleted    Boolean  @default(false) // Soft delete flag
  notificationsEnabled Boolean @default(false)
  
  // Onboarding data (merged from separate table)
  ageRange     String?  // Age range from onboarding
  vibeLevel    Int      @default(0)
  timeInvestmentHours Int @default(0)
  tosVersion   String?
  privacyVersion String?
  onboardedAt  DateTime? // When onboarding was completed

  // Materialized rating stats for performance
  eloRating    Float    @default(1500.0) // Elo-like rating (1000-2000 range)
  totalScore   Int      @default(0)      // Cached score (0-100)
  likeCount    Int      @default(0)      // Cached like count
  normalCount  Int      @default(0)      // Cached normal count
  totalRatings Int      @default(0)      // Cached total ratings
  lastRatedAt  DateTime? // Last time this user received a rating

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // When account was deleted
  photos       Photo[]
  givenRatings Rating[] @relation("RaterUser")
  receivedRatings Rating[] @relation("RatedUser")
  reportsSubmitted Report[] @relation("ReportReporter")

  @@unique([provider, providerId])
  @@unique([deviceId])
  @@index([eloRating(sort: Desc)])
  @@index([totalScore(sort: Desc)])
  @@index([gender, eloRating(sort: Desc)])
  @@index([isGuest, isDeleted, eloRating(sort: Desc)]) // Combined for better query performance
  @@index([isDeleted, lastRatedAt(sort: Desc)]) // For active user queries
  @@index([createdAt(sort: Desc)]) // For new user queries
  @@map("users")
}

model Photo {
  id               String   @id @default(cuid())
  userId           Int
  key              String   @unique // R2 storage key
  url              String   // Public URL
  format           String   // image format (png, jpg, etc.)
  size             Int      // file size in bytes
  isProfilePicture Boolean  @default(false)
  status           String   @default("active") // "active" | "hidden" | "deleted" | "pending_review"
  hiddenAt         DateTime? // When photo was hidden
  hiddenReason     String?  // Reason for hiding: "auto_reports" | "admin_action" | "user_deleted"
  takenAt          DateTime? // Original photo capture time from EXIF (if available)
  uploadedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings          Rating[]
  photoTags        PhotoTag[]
  reports          Report[]

  @@index([status, uploadedAt(sort: Desc)]) // For fetching active photos
  @@index([userId, status, takenAt(sort: Desc)]) // Combined for user photo queries
  @@index([userId, isProfilePicture, status]) // For profile picture queries
  @@index([uploadedAt(sort: Desc)]) // For recent photos
  @@map("photos")
}

model Rating {
  id        String   @id @default(cuid())
  raterId   Int      // 評分者
  ratedUserId Int    // 被評分者
  photoId   String   // 被評分的照片
  type      String   // "like" (❤️) or "normal" (🔄)

  // For recommendation system - similarity metrics
  raterEloAtTime   Float? // Rater's Elo at time of rating (for weighting)

  createdAt DateTime @default(now())

  rater     User     @relation("RaterUser", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser User     @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([raterId, photoId]) // 每個人對每張照片只能評分一次
  @@index([raterId, type, createdAt(sort: Desc)]) // For user preference and recent analysis
  @@index([ratedUserId, createdAt(sort: Desc)]) // For recent ratings received
  @@index([photoId, type]) // For photo stats
  @@index([createdAt(sort: Desc)]) // For time-based queries
  @@map("ratings")
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique // 標籤名稱 (英文)
  displayName String     // 顯示名稱 (中文)
  emoji       String?    // 可選的 emoji 圖示
  color       String?    // 標籤顏色 (hex code)
  category    String?    // 標籤分類 (如: style, occasion, season)
  normal      Boolean    @default(false) // 是否為常見標籤
  createdAt   DateTime   @default(now())
  photoTags   PhotoTag[]

  @@map("tags")
}

model PhotoTag {
  id      String @id @default(cuid())
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([photoId, tagId]) // 每張照片對每個標籤只能關聯一次
  @@map("photo_tags")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  key         String   @unique // R2 storage key
  url         String   // Public URL
  imageUrl    String?  // Public image URL (may be same as url); presigned GET will be generated at runtime
  format      String   // image format (webp preferred)
  size        Int      // file size in bytes
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Report {
  id         String   @id @default(cuid())
  photoId    String
  reporterId Int?
  reason     String   // "inappropriate" | "spam" | "harassment" | "nudity" | "violence" | "other"
  details    String?  // Optional detailed explanation
  status     String   @default("pending") // "pending" | "reviewed" | "dismissed" | "action_taken"
  reviewedAt DateTime?
  reviewedBy Int?     // Admin user ID who reviewed
  createdAt  DateTime @default(now())

  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  reporter User?  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([photoId, reporterId]) // One report per user per photo
  @@index([photoId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}
